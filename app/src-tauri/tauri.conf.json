{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claudebolt",
  "version": "0.1.0",
  "identifier": "dev.claudebolt.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "claudebolt", "width": 1400, "height": 860, "minWidth": 1000, "minHeight": 640, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": { "minimumSystemVersion": "14.0" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../engine-dist/claudebolt-engine/": "engine/" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3QkEwMzQ0ODE4QjkwMzQKUldRMGtJdUJSQU82bDVpT0Frd2hhZHVQR2l5RllUdG5XdS9kOTk0Q3BjLzFlUUxoWW1JQjJCcGIK",
      "endpoints": ["https://github.com/noahatholm/claudebolt/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
